<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Test projects restore the same transitive graph as src/ (NuGet.Protocol -> NuGet.Packaging
      -> System.Security.Cryptography.Pkcs, flagged by the NuGet audit), and the nearest
      Directory.Packages.props wins per project, so the pin must be declared here too.
      Pinned at 11.0.0 to match src. See src/Directory.Packages.props for details.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="TUnit.FsCheck" Version="1.87.12" />
  </ItemGroup>
</Project>
