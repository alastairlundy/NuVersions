<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      NuGet.Protocol pulls System.Security.Cryptography.Pkcs transitively at a low version
      (8.0.1) flagged by the NuGet audit (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7),
      which fails restore through TreatWarningsAsErrors. Transitive pinning lifts the
      package to a patched version; the property must live in Directory.Packages.props
      for the pin to apply. Pinned at 11.0.0.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CliInvoke.Core" Version="3.2.0-beta.1" />
    <PackageVersion Include="CliInvoke" Version="3.2.0-beta.1" />
    <PackageVersion Include="DotMake.CommandLine" Version="3.8.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.342" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="NuGet.Protocol" Version="8.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
</Project>

