<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      NuGet.Protocol 7.9.0 -> NuGet.Packaging 7.9.0 pulls System.Security.Cryptography.Pkcs
      8.0.1 (lowest version satisfying the dependency floor), which is flagged by the NuGet
      audit (GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7) and fails restore through
      TreatWarningsAsErrors. Transitive pinning lifts only that package to the patched 8.0.2;
      the property must live in Directory.Packages.props for the pin to apply.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="CliInvoke.Core" Version="3.0.3" />
    <PackageVersion Include="CliInvoke" Version="3.0.3" />
    <PackageVersion Include="DotMake.CommandLine" Version="3.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="Polyfill" PrivateAssets="all" Version="11.4.5" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
</Project>