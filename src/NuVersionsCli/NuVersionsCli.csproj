<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- LangVersion, Nullable and ImplicitUsings come from Directory.Build.props. -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>nuversions</ToolCommandName>
        <RollForward>Major</RollForward>
        <AssemblyName>nuversions</AssemblyName>
        <Title>NuVersions</Title>
        <Authors>Alastair Lundy</Authors>
        <Copyright>Copyright (c) Alastair Lundy 2026</Copyright>
        <RepositoryUrl>https://github.com/alastairlundy/NuVersions</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>unlist;nuget;dotnet-tool;cli;package</PackageTags>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageId>NuVersions</PackageId>
        <Description>Unlist NuGet package versions programmatically with ease.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>
        ## Changes since 0.3.0

### Added
- `show` reports per-version deprecation. Text output gains a trailing `Deprecation=[reasons]` segment with the server's reason words verbatim, and `Deprecation=unspecified` when the server gives none. A deprecated version with a custom message prints one stderr hint to rerun with `--output json` for the full record.
- `show --output json` lines gain a fourth `deprecation` field holding the full record, or JSON `null` when not deprecated. This changes the documented three-field `show` NDJSON schema; `unlist` is unchanged.

### Changed
- The `sdk` backend passes the API key to `dotnet nuget delete` via the child process's `NUGET_API_KEY` environment variable instead of the command line, so it no longer shows up in process listings.
- `--unlist-all` treats stable `0.x` versions as pre-release, so packages published only as `0.x` are no longer skipped.
- Dependency Updates: NuGet.Protocol 8.0.0, Microsoft.Extensions.* 11.0.0, System.Security.Cryptography.Pkcs 11.0.0, CliInvoke 3.2.0-beta.1, DotMake.CommandLine 3.8.0, Polyfill 12.0.0, TUnit 1.84.0, FsCheck 3.6.0, plus workflow action bumps.

### Removed
- `--include-zero-major`, now part of the pre-release definition itself.

### Fixed
- `show` observes Ctrl-C during the deprecation pass and exits `130`.
- Feed-side read failures print a one-line diagnostic naming the package id and server URL instead of a stack trace.
        </PackageReleaseNotes>
        <TargetFramework>net10.0</TargetFramework>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <IsAotCompatible>false</IsAotCompatible>
        <IsTrimmable>false</IsTrimmable>
        <Version>0.4.0</Version>
        <PackageVersion>0.4.0</PackageVersion>
        <AssemblyVersion>0.4.0.0</AssemblyVersion>
        <FileVersion>0.4.0.0</FileVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="NuVersionsLib.FuzzTests" />
      <InternalsVisibleTo Include="NuVersionsLib.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CliInvoke" />
      <PackageReference Include="DotMake.CommandLine"/>
      <PackageReference Include="Meziantou.Analyzer">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.Extensions.Configuration"/>
      <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables"/>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\NuVersionsLib\NuVersionsLib.csproj" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Localizations\Resources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Localizations\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
